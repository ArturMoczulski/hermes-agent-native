# Example environment for the local Plane Community deployment.
#
# This is a TEMPLATE, not live configuration. The live file is private and
# outside Git: ~/.local/share/agent-native/plane/plane.env
#
# Copy it to a private location, replace every CHANGE_ME, then start Compose:
#   docker compose -p agent-native-plane \
#     --env-file "$HOME/.local/share/agent-native/plane/plane.env" \
#     -f ops/plane/compose.yaml up -d
# Never commit the filled-in file. Values below match the single-owner local
# install published only on 127.0.0.1:19230 over HTTP.

APP_DOMAIN=localhost:19230
APP_RELEASE=v1.4.2

WEB_REPLICAS=1
SPACE_REPLICAS=1
ADMIN_REPLICAS=1
API_REPLICAS=1
WORKER_REPLICAS=1
BEAT_WORKER_REPLICAS=1
LIVE_REPLICAS=1

LISTEN_HTTP_PORT=19230
LISTEN_HTTPS_PORT=443
SITE_ADDRESS=:80
WEB_URL=http://localhost:19230
CORS_ALLOWED_ORIGINS=http://localhost:19230
API_BASE_URL=http://api:8000
DEBUG=0
GUNICORN_WORKERS=1

PGHOST=plane-db
PGDATABASE=plane
POSTGRES_USER=plane
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=plane
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data
DATABASE_URL=postgresql://plane:CHANGE_ME@plane-db/plane

REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/

RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_VHOST=plane
AMQP_URL=amqp://plane:CHANGE_ME@plane-mq:5672/plane

USE_MINIO=1
MINIO_ENDPOINT_SSL=0
AWS_REGION=
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads

SECRET_KEY=CHANGE_ME
LIVE_SERVER_SECRET_KEY=CHANGE_ME
CERT_EMAIL=
CERT_ACME_CA=
CERT_ACME_DNS=
FILE_SIZE_LIMIT=5242880

WEBHOOK_ALLOWED_IPS=
WEBHOOK_ALLOWED_HOSTS=

# This install is single-owner and localhost-only, so throttling is effectively
# disabled; these are runaway-loop guards only. Override via the private env.
# See README "Agent API request budget".
API_KEY_RATE_LIMIT=100000/minute
AUTHENTICATION_RATE_LIMIT=100000/minute
